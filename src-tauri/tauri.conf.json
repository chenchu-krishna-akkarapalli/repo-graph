{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v1.8.5/tooling/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Repo Graph",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "show": true
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Repo Graph",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark",
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "identifier": "com.repograph.desktop",
      "icon": [
        "icons/icon.ico"
      ],
      "resources": [
        "target/release/mcp_server.exe"
      ]
    }
  }
}
